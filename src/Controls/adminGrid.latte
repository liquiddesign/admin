<style>
    .small-table {
        width: 400px;
    }
</style>
{form filterForm}
{define filterInput, $component}
	{php
		$filterLabel = null;
		if ($component instanceof Nette\Forms\Controls\HiddenField) {
			$filterLabel = null;
		} elseif ($component->caption !== null && $component->caption !== '') {
			$filterLabel = (string) $component->caption;
		} elseif ($component instanceof Nette\Forms\Controls\TextInput) {
			$filterLabel = $component->control->getAttribute('placeholder');
		} elseif ($component instanceof Nette\Forms\Controls\SelectBox && $component->getPrompt() !== false) {
			$filterLabel = trim((string) $component->getPrompt(), '- ');
		} elseif ($component instanceof Nette\Forms\Controls\MultiSelectBox) {
			$filterLabel = $component->control->getAttribute('data-placeholder') ?? $component->control->getAttribute('placeholder');
			if ($filterLabel !== null) {
				$filterLabel = trim($filterLabel, '- ');
			}
		}
		if ($filterLabel === null && !$component instanceof Nette\Forms\Controls\HiddenField) {
			$filterLabel = $component->control->getAttribute('placeholder') ?? $component->control->getAttribute('data-placeholder');
			if ($filterLabel !== null) {
				$filterLabel = trim($filterLabel, '- ');
			}
		}
	}
	<div n:tag-if="!$component instanceof Nette\Forms\Controls\HiddenField" class="col-auto p-1 inline-style">
		<small class="text-muted d-block" style="line-height: 1.2;">{if $filterLabel}{$filterLabel}{else}&nbsp;{/if}</small>
		{$component->getControl()}
		{if $component instanceOf Nette\Forms\Controls\MultiSelectBox}
			<input type="hidden" name="{$component->getHtmlName()}" value="__none__">
		{/if}
	</div>
{/define}
	{do $components = $form->getComponents()}
	{do $submit = $components['submit'] ?? null}
	{do $reset = $components['reset'] ?? null}
	{ifset $submit}{php unset($components['submit'])}{/ifset}
	{ifset $reset}{php unset($components['reset'])}{/ifset}
	{if count($components) > 1}
		{if count($filterGroups) > 0}
			{php
				$ungrouped = [];
				$grouped = [];
				foreach ($components as $component) {
					$name = $component->getName();
					if (isset($filterGroupMap[$name])) {
						$groupName = $filterGroupMap[$name];
						$grouped[$groupName][] = $component;
					} else {
						$ungrouped[] = $component;
					}
				}
			}
			{if count($ungrouped) > 0}
				<div class="row align-items-end">
					<div class="col-12">
						<div class="form-group row mb-0">
							{foreach $ungrouped as $component}
								{include filterInput, $component}
							{/foreach}
						</div>
					</div>
				</div>
			{/if}
			{foreach $filterGroups as $groupName => $groupLabel}
				{if isset($grouped[$groupName])}
					<div class="row align-items-end">
						<div class="col-12">
							<div class="d-flex align-items-center">
								<span class="text-muted" style="font-size: .85rem; font-weight: 600; white-space: nowrap;">{$groupLabel}</span>
								<hr class="flex-grow-1 ml-2 my-0">
							</div>
							<div class="form-group row mb-0">
								{foreach $grouped[$groupName] as $component}
									{include filterInput, $component}
								{/foreach}
							</div>
						</div>
					</div>
				{/if}
			{/foreach}
			<div class="row align-items-end mb-2">
				<div class="col-12">
					<div class="form-group row mb-0">
						{ifset $submit}
							<div class="col-auto p-1">
								{$submit->getControl()}
							</div>
						{/ifset}
						{ifset $reset}
							<div class="col-auto p-1">
								{$reset->getControl()}
							</div>
						{/ifset}
					</div>
				</div>
			</div>
		{else}
			<div class="row align-items-end ">
				<div class="col-12">
					<div class="form-group row mb-0">
						{foreach $components as $component}
							{include filterInput, $component}
						{/foreach}
					{ifset $submit}
							<div class="col-auto p-1">
								<small class="text-muted d-block" style="line-height: 1.2;">&nbsp;</small>
								{$submit->getControl()}
							</div>
						{/ifset}
					{ifset $reset}
							<div class="col-auto p-1">
								<small class="text-muted d-block" style="line-height: 1.2;">&nbsp;</small>
								{$reset->getControl()}
							</div>
						{/ifset}
					</div>
				</div>
			</div>
		{/if}
	{/if}
{/form}
<div class="table-responsive table-striped">
	{form form}
		<table class="table table-sm lqd-table {$appendClass}">
			<thead class="admin-head">
			{foreach $columns as $column}
				{$column->renderHeaderCell()|noescape}
			{/foreach}
			</thead>
			{$control->getRows()}
		</table>
		<div class="table-footer-components d-lg-flex align-items-lg-center">
			<div class="table-footer-buttons d-lg-flex align-items-lg-center">
				{foreach $form->getComponents(false, Nette\Forms\Controls\Button::class) as $component}
					{$component->getControl()}
				{/foreach}
			</div>

			<div class="d-lg-flex align-items-lg ml-auto">
				<ul class="pagination align-items-center mb-0" n:if="!$showPaginator">
					<a n:href="this, showPaginator => true">Zobrazit stránkování</a>
				</ul>

				<ul class="pagination align-items-center mb-0" n:if="$showPaginator">
					<a n:if="!$defaultShowPaginator" n:href="this, showPaginator => false">Skrýt stránkování</a>

					{var $paginator = $control->getPaginator(true)}

					{if $showItemsPerPage}
						<li class="page-item disabled"><a href="#" class="page-link" style="border: 0;">{_'admin.onPage', 'Na stránce'}:</a></li>
						{foreach $itemsPerPage as $ipp}
							<li class="page-item {if $paginator->getItemsPerPage() == $ipp}disabled{/if}"><a href="{plink this $onpage => $ipp, $page => 1}" class="page-link">{$ipp}</a></li>
						{/foreach}
						<li class="page-item disabled"><a href="#" class="page-link" style="border: 0;">{$itemCountMessage}: {$paginator->itemCount|number:0,',',' '}</a></li>
					{/if}

					<li class="page-item {if $paginator->isFirst()}disabled{/if}"><a href="{plink this $page => 1}" class="page-link">{_'admin.firstPage', 'První'}</a></li>
					<li class="page-item {if $paginator->isFirst()}disabled{/if}">
						<a href="{plink this $page => $paginator->page-1}" class="page-link">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width: .75rem; line-height: 1;">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
							</svg>
						</a>
					</li>
					<li class="page-item disabled"><a href="#" class="page-link" style="border: 0;">{if $paginator->pageCount === 0}{_'admin.noPage', 'Žádné stránky'}{else}{_'admin.page', 'Stránka'} {$paginator->page} {_'admin.pageFrom', 'z'} {$paginator->pageCount}{/if}</a></li>
					<li class="page-item {if $paginator->isLast()}disabled{/if}">
						<a href="{plink this $page => $paginator->page+1}" class="page-link">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width: .75rem; line-height: 1;">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					</li>
					<li class="page-item {if $paginator->isLast()}disabled{/if}"><a href="{plink this $page => $paginator->pageCount}" class="page-link">{_'admin.lastPage', 'Poslední'}</a></li>
				</ul>
			</div>
		</div>
	{/form}
</div>